index fbc3472..2bb21d9 100644
--- a/verl/trainer/ppo/core_algos.py
+++ b/verl/trainer/ppo/core_algos.py
@@ -1082,6 +1082,117 @@ def agg_loss(
     return loss
 
 
+def compute_seed_opd_loss(
+    student_log_probs: torch.Tensor,
+    teacher_log_probs: torch.Tensor,
+    response_mask: torch.Tensor,
+    self_distillation_mask: Optional[torch.Tensor] = None,
+    gate_beta: float = 5.0,
+    loss_agg_mode: str = "token-mean",
+    batch_num_tokens: Optional[int] = None,
+    global_batch_size: Optional[int] = None,
+    loss_scale_factor: Optional[int] = None,
+) -> tuple[torch.Tensor, dict[str, Any]]:
+    """Compute SEED's sampled-token, confidence-gated OPD objective.
+
+    The teacher and the sigmoid gate are stop-gradient targets.  Only the
+    student's log probability for the already sampled response token receives
+    gradients.  ``self_distillation_mask`` means "teacher evidence exists";
+    it is deliberately independent of per-rollout correctness and is *not*
+    multiplied by ``(1 - reward)``.
+    """
+    if student_log_probs.shape != teacher_log_probs.shape:
+        raise ValueError(
+            "student and teacher sampled-token log-probs must have the same shape, "
+            f"got {tuple(student_log_probs.shape)} and {tuple(teacher_log_probs.shape)}"
+        )
+    if student_log_probs.shape != response_mask.shape:
+        raise ValueError(
+            "sampled-token log-probs and response_mask must have the same shape, "
+            f"got {tuple(student_log_probs.shape)} and {tuple(response_mask.shape)}"
+        )
+    if gate_beta <= 0:
+        raise ValueError(f"gate_beta must be positive, got {gate_beta}")
+
+    loss_mask = response_mask.to(dtype=student_log_probs.dtype)
+    if self_distillation_mask is not None:
+        sample_mask = self_distillation_mask.to(
+            device=student_log_probs.device, dtype=student_log_probs.dtype
+        )
+        if sample_mask.ndim == 1:
+            if sample_mask.shape[0] != loss_mask.shape[0]:
+                raise ValueError("self_distillation_mask batch dimension does not match log-probs")
+            sample_mask = sample_mask.unsqueeze(1)
+        elif sample_mask.shape != loss_mask.shape:
+            raise ValueError(
+                "self_distillation_mask must be sample-level [B] or token-level [B,T], "
+                f"got {tuple(sample_mask.shape)}"
+            )
+        loss_mask = loss_mask * sample_mask
+
+    teacher_target = teacher_log_probs.detach()
+    teacher_gap = (teacher_target - student_log_probs.detach()).detach()
+    gate = torch.sigmoid(float(gate_beta) * teacher_gap).detach()
+    loss_mat = gate * (teacher_target - student_log_probs)
+
+    active_tokens = loss_mask.sum()
+    if active_tokens.item() == 0:
+        loss = student_log_probs.sum() * 0.0
+        zero = student_log_probs.new_tensor(0.0)
+        return loss, {
+            "actor/seed_opd_active_token_ratio": zero.item(),
+            "actor/seed_opd_gate_mean": zero.item(),
+            "actor/seed_opd_gate_active_ratio": zero.item(),
+            "actor/seed_opd_teacher_gap_mean": zero.item(),
+            "actor/seed_opd_gate_std": zero.item(),
+            "actor/seed_opd_gate_p10": zero.item(),
+            "actor/seed_opd_gate_p50": zero.item(),
+            "actor/seed_opd_gate_p90": zero.item(),
+            "actor/seed_opd_teacher_gap_std": zero.item(),
+            "actor/seed_opd_teacher_gap_p10": zero.item(),
+            "actor/seed_opd_teacher_gap_p50": zero.item(),
+            "actor/seed_opd_teacher_gap_p90": zero.item(),
+            "actor/seed_opd_gate_top10_mass_fraction": zero.item(),
+        }
+
+    loss = agg_loss(
+        loss_mat=loss_mat,
+        loss_mask=loss_mask,
+        loss_agg_mode=loss_agg_mode,
+        batch_num_tokens=batch_num_tokens,
+        global_batch_size=global_batch_size,
+        loss_scale_factor=loss_scale_factor,
+    )
+    valid_gate = gate[loss_mask > 0].float()
+    valid_gap = teacher_gap[loss_mask > 0].float()
+    gate_quantiles = torch.quantile(valid_gate, valid_gate.new_tensor([0.1, 0.5, 0.9]))
+    gap_quantiles = torch.quantile(valid_gap, valid_gap.new_tensor([0.1, 0.5, 0.9]))
+    topk_count = max(1, (valid_gate.numel() + 9) // 10)
+    top10_gate_mass = torch.topk(valid_gate, k=topk_count, sorted=False).values.sum()
+    metrics = {
+        "actor/seed_opd_active_token_ratio": (loss_mask > 0).float().mean().detach().item(),
+        "actor/seed_opd_gate_mean": verl_F.masked_mean(gate, loss_mask).detach().item(),
+        "actor/seed_opd_gate_active_ratio": verl_F.masked_mean(
+            (gate > 0.5).float(), loss_mask
+        ).detach().item(),
+        "actor/seed_opd_teacher_gap_mean": verl_F.masked_mean(
+            teacher_gap, loss_mask
+        ).detach().item(),
+        "actor/seed_opd_gate_std": valid_gate.std(unbiased=False).detach().item(),
+        "actor/seed_opd_gate_p10": gate_quantiles[0].detach().item(),
+        "actor/seed_opd_gate_p50": gate_quantiles[1].detach().item(),
+        "actor/seed_opd_gate_p90": gate_quantiles[2].detach().item(),
+        "actor/seed_opd_teacher_gap_std": valid_gap.std(unbiased=False).detach().item(),
+        "actor/seed_opd_teacher_gap_p10": gap_quantiles[0].detach().item(),
+        "actor/seed_opd_teacher_gap_p50": gap_quantiles[1].detach().item(),
+        "actor/seed_opd_teacher_gap_p90": gap_quantiles[2].detach().item(),
+        "actor/seed_opd_gate_top10_mass_fraction": (
+            top10_gate_mass / valid_gate.sum().clamp_min(1e-12)
+        ).detach().item(),
+    }
+    return loss, metrics
+
+
 def compute_self_distillation_loss(
     student_log_probs: torch.Tensor,
     teacher_log_probs: torch.Tensor,
